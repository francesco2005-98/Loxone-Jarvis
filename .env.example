# Required. Encrypts every stored key. Generate once, keep it in Coolify as a secret:
#   openssl rand -base64 48
JARVIS_SECRET_KEY=

# Optional. Otherwise the first visit of the web interface asks for a password.
JARVIS_INITIAL_PASSWORD=

# Optional. Comma separated networks allowed to open Jarvis. Default: private ranges only.
JARVIS_TRUSTED_NETWORKS=

# Optional. Host and container port of the web interface (default 8500).
# Open http://<server>:8500. No domain required.
JARVIS_HTTP_PORT=8500

# Optional. HTTPS port with a self-signed certificate (default 8501, 0 turns it off).
# The Live page needs it for the tablet microphone: https://<server>:8501/#live
JARVIS_HTTPS_PORT=8501

# Optional. 1 keeps the login cookie working over plain HTTP. Set 0 only behind HTTPS.
JARVIS_INSECURE_COOKIES=1

# Optional. Host port the microphones report to (default 8765).
JARVIS_DEVICE_PORT=8765
